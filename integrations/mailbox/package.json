{
  "name": "codex-accounts-mailbox",
  "displayName": "Codex Accounts Mailbox",
  "description": "Optional provider-neutral mailbox query and manual credential renewal integration for Codex Accounts Manager.",
  "version": "0.2.7",
  "publisher": "codex-accounts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wintermelon008/codex-accounts-manager-local-usage.git"
  },
  "engines": {
    "node": ">=18.18.0",
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "codexAccountsMailbox.open",
        "title": "Mailbox: Open Mailbox"
      },
      {
        "command": "codexAccountsMailbox.openRegistrationDiagnostics",
        "title": "Mailbox: Open Registration Diagnostics"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/core/*.test.cjs test/mailbox/*.test.cjs test/operations/*.test.cjs test/integration/*.test.cjs test/ui/*.test.cjs",
    "check": "node -e \"for (const file of ['src/managerApi.cjs','src/core/account.cjs','src/core/codes.cjs','src/core/errors.cjs','src/core/messages.cjs','src/core/provider.cjs','src/core/providers/eight92.cjs','src/core/providers/boya.cjs','src/core/providers/cdns.cjs','src/core/providers/index.cjs','src/core/index.cjs','src/mailbox/storage.cjs','src/operations/coordinator.cjs','src/operations/browser-mode.cjs','src/operations/virtual-display.cjs','src/operations/registration-flow.cjs','src/operations/registration-manager.cjs','src/operations/registration-email-code.cjs','src/operations/registration-key-pool.cjs','src/operations/registration-phone-sources.cjs','src/operations/registration-diagnostics.cjs','src/operations/index.cjs','src/ui/panel.cjs','src/ui/integration.cjs']) require('./' + file)\"",
    "audit:portability": "node scripts/audit-portability.cjs",
    "package:check": "npm run check && npm run audit:portability && node scripts/check-package.cjs",
    "package": "npm test && npm run package:check && node scripts/prepare-dist.cjs && npx --no-install vsce package --dependencies --out dist/codex-accounts-mailbox.vsix"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
