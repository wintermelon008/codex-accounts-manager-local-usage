{
  "name": "@codex-accounts/feishu-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Feishu assistant for the local Codex Accounts Manager control API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wintermelon008/codex-accounts-manager-local-usage.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "feishu-assistant": "./src/cli.mjs"
  },
  "files": [
